@page "/"
@using Microsoft.FluentUI.AspNetCore.Components
@using Microsoft.AspNetCore.Components
@using AtCoderRevManager.Web.Models
@using AtCoderRevManager.Web.Services
@inject ReviewApiClient ReviewApi
@inject IDialogService DialogService
@inject IToastService ToastService
@inject ILogger<Home> Logger
@rendermode InteractiveServer

<PageTitle>Dashboard | AtCoderRevManager</PageTitle>

<div class="u-row u-mb-5 fade-up">
    <div class="section-title">
        <FluentLabel Typo="Typography.H3" Class="gradient-text">Review Dashboard</FluentLabel>
        <span class="section-title__hint">Spaced repetition, operationalized.</span>
    </div>

    <div class="u-spacer"></div>

    <FluentButton Appearance="Appearance.Accent" IconStart="@_addIcon" OnClick="@OpenCreateDialogAsync">
        New Review
    </FluentButton>
</div>

@if (_reviews == null)
{
    <div class="glass panel cyber-card sweep shimmer tap" data-glow="accent">
        <FluentStack HorizontalAlignment="HorizontalAlignment.Center"
                     VerticalAlignment="VerticalAlignment.Center"
                     Class="loadingArea">
            <FluentProgressRing />
            <FluentLabel Class="muted">Loading your learning path…</FluentLabel>
        </FluentStack>
    </div>
}
else
{
    <div class="dashboard-grid fade-up">
        <section class="dashboard-main">
            <div class="kpi-grid u-mb-5">
                <div class="kpi cyber-card sweep shimmer pop tap kpi--danger" data-glow="accent">
                    <div class="kpi__label">🔥 Due Today</div>
                    <div class="kpi__valueRow">
                        <div class="kpi__value">@DueCount</div>
                        <div class="muted">tasks</div>
                    </div>
                </div>

                <div class="kpi cyber-card sweep shimmer pop tap kpi--accent">
                    <div class="kpi__label">Total Reviews</div>
                    <div class="kpi__valueRow">
                        <div class="kpi__value">@TotalCount</div>
                    </div>
                </div>

                <div class="kpi cyber-card sweep shimmer pop tap kpi--success">
                    <div class="kpi__label">Solved</div>
                    <div class="kpi__valueRow">
                        <div class="kpi__value">@SolvedCount</div>
                    </div>
                </div>

                <div class="kpi cyber-card sweep shimmer pop tap kpi--warning">
                    <div class="kpi__label">Completion Rate</div>
                    <div class="kpi__valueRow">
                        <div class="kpi__value">@CompletionRate</div>
                        <div class="muted">%</div>
                    </div>
                </div>
            </div>

            @if (_reviews.Count == 0)
            {
                <FluentMessageBar Intent="MessageIntent.Info">
                    No reviews found. Start your first review cycle by clicking “New Review”.
                </FluentMessageBar>
            }
            else
            {
                <div class="glass panel u-mb-4 cyber-card sweep shimmer tap">
                    <div class="u-row focus-ring">
                        <FluentSearch class="u-w-320"
                                      @bind-Value="_searchTerm"
                                      @bind-Value:after="ResetPagination"
                                      Placeholder="Search by ID or Title…" />

                        <FluentSelect TOption="string" @bind-Value="_statusFilter" @bind-Value:after="ResetPagination">
                            <FluentOption Value="All">All Status</FluentOption>
                            <FluentOption Value="Solved">Solved</FluentOption>
                            <FluentOption Value="Unsolved">Unsolved</FluentOption>
                        </FluentSelect>

                        <FluentSwitch @bind-Value="_showDueOnly" @bind-Value:after="ResetPagination" Label="🔥 Due Today Only" />

                        <div class="u-spacer"></div>
                    </div>

                    <div class="data-surface">
                        <FluentDataGrid Items="@FilteredReviews"
                                        ResizableColumns="true"
                                        Pagination="@_pagination"
                                        Class="grid">
                            <PropertyColumn Property="@(r => r.ProblemId)" Sortable="true" Title="Problem" />
                            <PropertyColumn Property="@(r => r.Title)" Sortable="true" />

                            <TemplateColumn Title="Difficulty" Context="review">
                                <FluentBadge BackgroundColor="@GetDifficultyColor(review.Difficulty)" Color="white">
                                    @review.Difficulty
                                </FluentBadge>
                            </TemplateColumn>

                            <TemplateColumn Title="Next Review" Context="review" Sortable="true" SortBy="@_nextReviewSorter">
                                <FluentStack VerticalAlignment="VerticalAlignment.Center" HorizontalGap="6">
                                    @if (review.IsDue)
                                    {
                                        <FluentIcon Value="@_dueIcon" Color="Color.Error" />
                                        <span class="due">@review.NextReviewDate.ToString("MM/dd")</span>
                                    }
                                    else
                                    {
                                        <span class="muted">@review.NextReviewDate.ToString("MM/dd")</span>
                                    }
                                </FluentStack>
                            </TemplateColumn>

                            <TemplateColumn Title="Status" Context="review">
                                @if (review.IsSolved)
                                {
                                    <FluentIcon Value="@_checkIcon" Color="Color.Success" />
                                }
                                else
                                {
                                    <FluentIcon Value="@_circleIcon" Color="Color.Warning" />
                                }
                            </TemplateColumn>

                            <TemplateColumn Title="Actions" Context="review">
                                <FluentButton IconStart="@_editIcon" Appearance="Appearance.Lightweight" OnClick="@(() => OpenEditDialogAsync(review))" />
                                <FluentButton IconStart="@_deleteIcon" Appearance="Appearance.Lightweight" OnClick="@(() => DeleteReviewAsync(review))" />
                            </TemplateColumn>
                        </FluentDataGrid>

                        <FluentPaginator State="@_pagination" />
                    </div>
                </div>
            }
        </section>

        <aside class="dashboard-side">
            <div class="side-card cyber-card sweep shimmer tap">
                <div class="side-card__title">Today</div>
                <div class="side-metric">
                    <div class="side-metric__value">@DueCount</div>
                    <div class="side-metric__label">due items</div>
                </div>

                <div class="side-list">
                    @foreach (var item in DuePreview)
                    {
                        <div class="side-item">
                            <div class="side-item__main">
                                <div class="side-item__id">@item.ProblemId</div>
                                <div class="side-item__title">@item.Title</div>
                            </div>
                            <div class="side-item__meta">
                                <span class="pill pill--danger">@item.NextReviewDate.ToString("MM/dd")</span>
                            </div>
                        </div>
                    }

                    @if (DuePreview.Count == 0)
                    {
                        <div class="muted">No due items. Great pace.</div>
                    }
                </div>

                <div class="side-actions">
                    <FluentButton Appearance="Appearance.Accent" OnClick="@EnableDueOnlyAsync">
                        Focus Due
                    </FluentButton>
                    <FluentButton Appearance="Appearance.Outline" OnClick="@OpenCreateDialogAsync">
                        Add
                    </FluentButton>
                </div>
            </div>

            <div class="side-card cyber-card sweep shimmer tap">
                <div class="side-card__title">Next Up</div>

                @if (NextUp is not null)
                {
                    <div class="side-next">
                        <div class="side-next__date">@NextUp.Value.Date.ToString("yyyy/MM/dd")</div>
                        <div class="side-next__hint muted">next scheduled review</div>
                    </div>
                }
                else
                {
                    <div class="muted">No upcoming items.</div>
                }

                <div class="side-miniGrid">
                    <div class="miniStat">
                        <div class="miniStat__value">@TotalCount</div>
                        <div class="miniStat__label">total</div>
                    </div>
                    <div class="miniStat">
                        <div class="miniStat__value">@SolvedCount</div>
                        <div class="miniStat__label">solved</div>
                    </div>
                    <div class="miniStat">
                        <div class="miniStat__value">@CompletionRate%</div>
                        <div class="miniStat__label">rate</div>
                    </div>
                </div>
            </div>

            <div class="side-card cyber-card sweep shimmer tap">
                <div class="side-card__title">Insights</div>
                <div class="muted">Keep sessions short. Consistency beats intensity.</div>

                <div class="side-miniGrid">
                    <div class="miniStat">
                        <div class="miniStat__value">—</div>
                        <div class="miniStat__label">streak</div>
                    </div>
                    <div class="miniStat">
                        <div class="miniStat__value">@DueCount</div>
                        <div class="miniStat__label">due</div>
                    </div>
                    <div class="miniStat">
                        <div class="miniStat__value">@(_showDueOnly ? "ON" : "OFF")</div>
                        <div class="miniStat__label">focus</div>
                    </div>
                </div>
            </div>
        </aside>
    </div>
}

@code {
    private const string UserId = "haru";

    private List<ReviewModel>? _reviews;
    private readonly PaginationState _pagination = new() { ItemsPerPage = 10 };

    private string _searchTerm = string.Empty;
    private string _statusFilter = "All";
    private bool _showDueOnly;

    [SupplyParameterFromQuery(Name = "due")]
    public bool DueQuery { get; set; }

    [SupplyParameterFromQuery(Name = "create")]
    public bool CreateQuery { get; set; }

    private bool _pendingAutoCreate;
    private bool _autoCreateTriggered;

    private readonly Icon _addIcon = new Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size24.Add();
    private readonly Icon _checkIcon = new Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size20.CheckmarkCircle();
    private readonly Icon _circleIcon = new Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size20.Circle();
    private readonly Icon _deleteIcon = new Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size20.Delete();
    private readonly Icon _editIcon = new Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size20.Edit();
    private readonly Icon _dueIcon = new Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size20.Warning();

    private readonly GridSort<ReviewModel> _nextReviewSorter =
        GridSort<ReviewModel>.ByAscending(r => r.NextReviewDate);

    private int TotalCount => _reviews?.Count ?? 0;
    private int SolvedCount => _reviews?.Count(r => r.IsSolved) ?? 0;
    private int DueCount => _reviews?.Count(r => r.IsDue) ?? 0;

    private string CompletionRate =>
        TotalCount == 0 ? "0.0" : ((double)SolvedCount / TotalCount * 100).ToString("F1");

    private List<ReviewModel> DuePreview =>
        _reviews is null
            ? []
            : _reviews
                .Where(r => r.IsDue)
                .OrderBy(r => r.NextReviewDate)
                .Take(5)
                .ToList();

    private DateTime? NextUp =>
        _reviews is null
            ? null
            : _reviews
                .Where(r => !r.IsDue)
                .OrderBy(r => r.NextReviewDate)
                .Select(r => (DateTime?)r.NextReviewDate.Date)
                .FirstOrDefault();

    private IQueryable<ReviewModel>? FilteredReviews
    {
        get
        {
            if (_reviews is null) return null;

            var query = _reviews.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(_searchTerm))
            {
                query = query.Where(r =>
                    r.ProblemId.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase) ||
                    r.Title.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase));
            }

            query = _statusFilter switch
            {
                "Solved" => query.Where(r => r.IsSolved),
                "Unsolved" => query.Where(r => !r.IsSolved),
                _ => query
            };

            if (_showDueOnly)
            {
                query = query.Where(r => r.IsDue);
            }

            return query
                .OrderByDescending(r => r.IsDue)
                .ThenBy(r => r.NextReviewDate)
                .AsQueryable();
        }
    }

    protected override async Task OnInitializedAsync()
        => await LoadDataAsync();

    protected override Task OnParametersSetAsync()
    {
        if (DueQuery)
        {
            _showDueOnly = true;
        }

        if (CreateQuery)
        {
            _pendingAutoCreate = true;
        }

        return Task.CompletedTask;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_pendingAutoCreate && !_autoCreateTriggered && _reviews is not null)
        {
            _autoCreateTriggered = true;
            _pendingAutoCreate = false;
            await OpenCreateDialogAsync();
        }
    }

    private async Task LoadDataAsync()
    {
        try
        {
            _reviews = await ReviewApi.GetReviewsAsync(UserId);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load data for user {UserId}", UserId);
            ToastService.ShowError("Failed to fetch data from the server.");
            _reviews = [];
        }
    }

    private async Task EnableDueOnlyAsync()
    {
        _showDueOnly = true;
        await ResetPagination();
        StateHasChanged();
    }

    private async Task OpenCreateDialogAsync()
    {
        var initialData = new CreateReviewRequest
        {
            ProblemId = string.Empty,
            Title = string.Empty,
            ContestName = string.Empty,
            Difficulty = 0
        };

        var dialog = await DialogService.ShowDialogAsync<AtCoderRevManager.Web.Components.Dialogs.ReviewDialog>(
            initialData,
            new DialogParameters
            {
                Title = "Register Review",
                PreventDismissOnOverlayClick = true,
                Width = "500px"
            });

        var result = await dialog.Result;

        if (result.Cancelled || result.Data is not CreateReviewRequest request) return;

        try
        {
            await ReviewApi.CreateReviewAsync(UserId, request);
            await LoadDataAsync();
            ToastService.ShowSuccess("Review registered successfully!");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error creating review.");
            ToastService.ShowError("Could not register the review.");
        }
    }

    private async Task OpenEditDialogAsync(ReviewModel review)
    {
        var dialog = await DialogService.ShowDialogAsync<AtCoderRevManager.Web.Components.Dialogs.ReviewProgressDialog>(
            review,
            new DialogParameters
            {
                Title = "Update Progress",
                PreventDismissOnOverlayClick = true,
                Width = "500px"
            });

        var result = await dialog.Result;

        if (result.Cancelled || result.Data is not UpdateProgressRequest request) return;

        try
        {
            await ReviewApi.UpdateProgressAsync(UserId, review.Id, request.IsSolved, request.Notes);
            await LoadDataAsync();
            ToastService.ShowSuccess("Progress updated successfully!");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error updating progress for ID: {Id}", review.Id);
            ToastService.ShowError("Could not update progress.");
        }
    }

    private async Task DeleteReviewAsync(ReviewModel review)
    {
        var dialog = await DialogService.ShowConfirmationAsync(
            $"Delete review for {review.ProblemId}?",
            "Delete",
            "Cancel",
            "Deletion Confirmation");

        var result = await dialog.Result;
        if (result.Cancelled) return;

        try
        {
            await ReviewApi.DeleteReviewAsync(UserId, review.Id);
            await LoadDataAsync();
            ToastService.ShowInfo("Review deleted.");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error deleting review ID: {Id}", review.Id);
            ToastService.ShowError("Could not delete the review.");
        }
    }

    private async Task ResetPagination()
        => await _pagination.SetCurrentPageIndexAsync(0);

    private string GetDifficultyColor(int difficulty)
    {
        if (difficulty < 400) return "#808080";
        if (difficulty < 800) return "#804000";
        if (difficulty < 1200) return "#008000";
        if (difficulty < 1600) return "#00C0C0";
        if (difficulty < 2000) return "#0000FF";
        if (difficulty < 2400) return "#C0C000";
        if (difficulty < 2800) return "#FF8000";
        return "#FF0000";
    }
}